# Copy this file to .env.local and fill in your Supabase values.
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Required by the clock in/out and location ping API routes and
# by the admin "add employee" route. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional. IANA timezone the time clock displays and buckets days in.
# Defaults to America/Denver (Mountain) when unset.
NEXT_PUBLIC_TIME_ZONE=America/Denver
